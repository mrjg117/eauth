# 复制为实际变量。ESA 函数变量键只能用字母、数字、下划线；旧版套餐改变量需重新发版。
# 密钥类（带 SECRET / KEY / TOKEN）务必勾选「加密存储」。

# ---- 域名与服务白名单 ----
AUTH_BASE=https://auth.example.com
# 一个 service 只能配白名单内的回跳前缀；providers 是允许的平台
SERVICES={"a":{"redirect":["https://a.example.com/"],"providers":["wxmp","ali","qq","gitee","github"]},"b":{"redirect":["https://b.example.com/"],"providers":["wxmp","gitee"]}}

# ---- 运行模式 ----
# strict=查白名单放行 / open=显示身份哈希用于登记 / off=全局拒绝
AUTH_MODE=strict

# ---- 签名密钥（32 字节随机 base64，两者不同）----
# 生成：openssl rand -base64 32
JWT_SECRET=
COOKIE_SECRET=
JWT_TTL=604800

# ---- 平台凭据（不用哪个就留空）----
WX_ID=
WX_SECRET=
WXMP_ID=
WXMP_SECRET=
ALI_ID=
ALI_SECRET=
ALI_PRIVATE_KEY=
QQ_ID=
QQ_SECRET=
GITEE_ID=
GITEE_SECRET=
GH_ID=
GH_SECRET=
DY_ID=
DY_SECRET=
PROVIDERS=wxmp,ali,qq,gitee,github

# ---- 用户白名单：CSV 直链 + env 兜底 ----
# 腾讯文档/飞书/金山的「分享链接」返回网页 HTML，不能直接当 CSV 读。
# 正确做法：在这些表格里编辑 -> 导出 CSV -> 传到能返回纯文本的直链。
#   推荐1（已有仓库）：https://cdn.jsdelivr.net/gh/mrjg117/eauth@main/allowlist.csv
#   推荐2：https://raw.githubusercontent.com/mrjg117/eauth/main/allowlist.csv（大陆不稳定）
# 函数用 ESA Cache API 缓存 60s，改名单最多 60s 后生效。
# CSV 每行三列：provider:哈希,状态,备注     例：wxm:ab12cd34ef567890,active,laptop
ALLOWLIST_URL=https://cdn.jsdelivr.net/gh/mrjg117/eauth@main/allowlist.csv
# 若表格导出需要 Bearer token，填这里（加密存储）；公开直链留空
ALLOWLIST_TOKEN=
# 方式B：env 兜底名单，防止表格拉取失败把自己锁在外面
ALLOWED_USERS=wxm:ab12cd34ef567890,ali:9f8e7d6c5b4a3210
